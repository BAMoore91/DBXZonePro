<?xml version="1.0" encoding="utf-8"?>
<variables>
  <category name="Status">
    <variable name="Device Online" sysvar="Online" type="boolean"
              format="B:Offline:Online" sample="true" />
    <variable name="Current Scene" sysvar="CurrentScene" type="integer"
              min="0" max="500" sample="1" />
  </category>

  <category name="%%__Zone1Name%%" condition="$Zone1Enabled" sourceid="Zone1">
    <variable name="%%__Zone1Name%% Source" sysvar="Zone1Source" type="integer" min="0" max="12" sample="1" />
    <variable name="%%__Zone1Name%% Level" sysvar="Zone1LevelPct" type="integer" min="0" max="100" sample="52" />
    <variable name="%%__Zone1Name%% Level dB" sysvar="Zone1LevelDb" type="string" sample="-10.0 dB" />
    <variable name="%%__Zone1Name%% Mute" sysvar="Zone1Mute" type="boolean" format="B: :Muted" sample="false" />
  </category>

