  <category name="Input Gains">
    <function name="Set Input Gain (Percent)" export="SetInputGainPct" repeatrate="0">
      <parameter name="Input" type="integer" min="1" max="12" default="1"
                 description="Device input number. The input's gain object ID must be configured in the driver settings." />
      <parameter name="Level" type="integer" min="0" max="100" default="50"
                 description="Input gain, 0-100%." />
    </function>
  </category>

  <category name="Advanced">
    <function name="Send Custom Command" export="SendCustom" repeatrate="0">
      <parameter name="Message Hex" type="string" maxlength="240"
                 description="dbx message in hex, from the Version byte (01) through the payload. Capture with ZonePro Designer's Network Trace (Ctrl+Shift+T). The driver adds serial framing and checksum automatically." />
    </function>
    <function name="Resync Serial Link" export="ForceResync" repeatrate="0" />
  </category>
</functions>
