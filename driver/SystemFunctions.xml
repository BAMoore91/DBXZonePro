<?xml version="1.0" encoding="utf-8"?>
<functions>
  <category name="Scenes">
    <function name="Recall Scene" export="RecallScene" repeatrate="0">
      <parameter name="Scene" type="integer" min="0" max="500" default="1"
                 description="Scene number stored in the ZonePro (0 = default scene)." />
    </function>
  </category>

  <category name="Zone Control">
    <function name="Select Source" export="SelectSource" repeatrate="0">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
      <parameter name="Source" type="integer" min="0" max="12" default="1"
                 description="Router input number (0 = none/off). Stereo pairs are addressed by their lower input number." />
    </function>

    <function name="Set Level (Percent)" export="SetLevelPct" repeatrate="0">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
      <parameter name="Level" type="integer" min="0" max="100" default="50"
                 description="Zone output level, 0-100%. Attach to a slider for direct control." />
    </function>

    <function name="Set Level (Raw)" export="SetLevelRaw" repeatrate="0">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
      <parameter name="Raw Value" type="integer" min="0" max="500" default="215"
                 description="Raw fader counts (protocol guide: 0-415, 215 = 0 dB, 10 counts per dB)." />
    </function>

    <function name="Level Up" export="LevelUp" repeatrate="200">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
    </function>

    <function name="Level Down" export="LevelDown" repeatrate="200">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
    </function>

    <function name="Mute On" export="MuteOn" repeatrate="0">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
    </function>

    <function name="Mute Off" export="MuteOff" repeatrate="0">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
    </function>

    <function name="Mute Toggle" export="MuteToggle" repeatrate="0">
      <parameter name="Zone" type="mcinteger" default="1" description="Output zone.">
        <choice name="%%__Zone1Name%%" value="1" condition="$Zone1Enabled" />
        <choice name="%%__Zone2Name%%" value="2" condition="$Zone2Enabled" />
        <choice name="%%__Zone3Name%%" value="3" condition="$Zone3Enabled" />
        <choice name="%%__Zone4Name%%" value="4" condition="$Zone4Enabled" />
        <choice name="%%__Zone5Name%%" value="5" condition="$Zone5Enabled" />
        <choice name="%%__Zone6Name%%" value="6" condition="$Zone6Enabled" />
      </parameter>
    </function>
  </category>

  <category name="Room Volume (Autoprogramming)">
    <function name="%%__Zone1Name%% Volume Up" export="LevelUp:Z1" repeatrate="200"
              condition="$Zone1Enabled" buttontag="VolumeUp" sourceid="Zone1">
