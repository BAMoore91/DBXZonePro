    </function>
    <function name="%%__Zone1Name%% Volume Down" export="LevelDown:Z1" repeatrate="200"
              condition="$Zone1Enabled" buttontag="VolumeDown" sourceid="Zone1">
      <parameter name="Zone" type="integer" min="1" max="6" default="1" hidden="true" />
    </function>
    <function name="%%__Zone1Name%% Mute Toggle" export="MuteToggle:Z1" repeatrate="0"
              condition="$Zone1Enabled" buttontag="MuteToggle" sourceid="Zone1">
      <parameter name="Zone" type="integer" min="1" max="6" default="1" hidden="true" />
